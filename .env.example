# Copier en .env.local (jamais commité) et renseigner avec les vraies valeurs.

# --- Client (exposées au navigateur, aucune valeur secrète ici) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Serveur uniquement (fonctions api/, jamais exposées au client) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Resend (e-mails transactionnels, serveur uniquement) ---
# Sans ces deux valeurs, api/_lib/email.ts reste inerte : l'app fonctionne normalement, elle
# n'envoie simplement aucun e-mail (voir le commentaire en tête de ce fichier).
RESEND_API_KEY=
# Adresse d'expédition, ex. "Hari Online Club <contact@hari-online-club.com>". Le domaine doit
# être vérifié dans le tableau de bord Resend (enregistrements DNS), sinon l'envoi échoue.
RESEND_FROM=

# --- Google Calendar / Meet (serveur uniquement) ---
# Identifiants OAuth du projet Google Cloud de l'établissement. Sans eux, l'application
# fonctionne normalement mais les séances gardent un lien de visioconférence interne.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit correspondre exactement à l'URI de redirection déclarée dans la console Google :
# https://<domaine>/api/admin/google-oauth-callback
GOOGLE_REDIRECT_URI=
# Phrase secrète quelconque : elle chiffre le jeton Google stocké en base et signe le paramètre
# `state` du flux OAuth. La changer rend les comptes déjà connectés illisibles (il faut alors
# reconnecter le compte Google depuis Paramètres).
GOOGLE_TOKEN_KEY=
